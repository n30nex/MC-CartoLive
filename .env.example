# HTTP
LISTEN_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:39476

# OpenFreeMap 3D in-app map mode
# Leave blank to use the bundled dark/light OpenFreeMap 3D styles.
VITE_OPENFREEMAP_STYLE_URL=
VITE_OPENFREEMAP_TILEJSON_URL=https://tiles.openfreemap.org/planet
VITE_TERRAIN_TILE_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
VITE_TERRAIN_EXAGGERATION=1.25
# Optional PMTiles basemap/terrain archives for Offline PMTiles and Field Offline profiles.
# Prefer same-origin or CSP-allowed HTTPS URLs, for example /tiles/canada.pmtiles.
VITE_PMTILES_BASEMAP_URL=
VITE_PMTILES_TERRAIN_URL=
# Runtime. Release version, Git SHA, and build time are compiled into published
# images and cannot be overridden by production environment variables.
VITE_APP_BRAND_NAME=MC-CartoLive
VITE_APP_BRAND_URL=https://github.com/n30nex/MC-CartoLive
VITE_APP_BRAND_LOGO=
VITE_APP_ASSET_PACK=world
VITE_ENABLE_SERVICE_WORKER=false
DATA_DIR=/app/data
DB_PATH=/app/data/meshcore-live.db
SQLITE_READ_OPEN_CONNS=2
SQLITE_BUSY_TIMEOUT_MS=750
SQLITE_CACHE_SIZE_KB=16000
SQLITE_MMAP_SIZE_BYTES=67108864
DATA_RETENTION_DAYS=7
PUBLIC_EVENT_RETENTION_HOURS=24
# Development escape hatch only. PUBLIC_MODE=true remains unready when this is
# enabled, and production Compose fixes it to false.
ALLOW_UNBOUNDED_RETENTION=false
LOG_LEVEL=info
TZ=America/Toronto
PUBLIC_MODE=true

# MQTT source
# Public examples run the synthetic fixture by default. Set true only after
# adding private MQTT credentials in your local .env.
MQTT_ENABLED=false
MQTT_BROKER_URL=wss://mqtt1.meshcore.ca:443/mqtt
MQTT_TOPIC=meshcore/#
MQTT_CLIENT_ID=meshcore-canada-live-map-local

# Auth mode: subscriber is preferred for analyzer/read-only full feed.
# Leave blank in the committed example. Put real credentials only in local .env.
MESHCORE_AUTH_MODE=subscriber
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional future auth mode: key/JWT, only if broker permits analyzer subscription by key.
# Leave private keys blank in public examples.
MESHCORE_PUBLIC_KEY_HEX=
MESHCORE_PRIVATE_KEY_HEX=
MQTT_TOKEN_AUDIENCE=mqtt1.meshcore.ca

# Public group channel text: the MeshCore default Public channel is decoded
# automatically for sanitized message bubbles.
# Comma-separate additional raw 16-byte keys or hashtag channel names like
# #wardriving when needed. Never commit real private channel secrets.
MESHCORE_CHANNEL_SECRETS=

# RF truth gates
STRICT_RF_ONLY=true
REQUIRE_RSSI_OR_SNR_FOR_EDGE=true
MAX_UNVERIFIED_EDGE_KM=150
ALLOW_LONG_TRACE_EDGES=true

# Public propagation insights
PROPAGATION_ENABLED=true
PROPAGATION_MIN_DISTANCE_KM=75
PROPAGATION_FETCH_INTERVAL_SECONDS=900
PROPAGATION_EVENT_RETENTION_DAYS=7

# Initial map and public region policy.
# Package default is worldwide. Hosted Canada deployments should set
# MAP_REGION_PRESET=canada and PUBLIC_REGIONS to the supported Canadian region
# labels. For private brokers, leave PUBLIC_REGIONS blank to allow all safe
# broker region labels.
MAP_REGION_PRESET=world
# Custom bounds format: minLat,minLng,maxLat,maxLng
# Example Australia bounds: MAP_BOUNDS=-45,110,-10,155
MAP_BOUNDS=
DEFAULT_CENTER_LAT=
DEFAULT_CENTER_LNG=
DEFAULT_ZOOM=
DEFAULT_REGION=WORLD

# Live buffers
RECENT_PACKET_LIMIT=1000
RECENT_EDGE_EVENT_LIMIT=2000
WS_CLIENT_QUEUE_SIZE=512
MQTT_INGEST_QUEUE_SIZE=4096
DERIVED_INGEST_QUEUE_SIZE=1024
PUBLIC_CACHE_REFRESH_SECONDS=10
PUBLIC_PACKET_PATH_BACKFILL_ENABLED=true
PUBLIC_PACKET_PATH_BACKFILL_BATCH=500
PUBLIC_PACKET_PATH_BACKFILL_HOURS=24
PUBLIC_EVENTS_ENABLED=true
PUBLIC_WS_RESUME_ENABLED=true
PUBLIC_WS_SUBSCRIPTIONS_ENABLED=false
VITE_PUBLIC_WS_SUBSCRIPTIONS_ENABLED=false
PUBLIC_VIEWPORT_ENABLED=true
NOC_MODE_ENABLED=true
COVERAGE_ENABLED=true
LOS_ENABLED=true
PUBLIC_SCHEMA_ENABLED=true
PUBLIC_INTEGRATIONS_ENABLED=true
# Trust reverse-proxy client IP headers only when direct public access to the app port is blocked.
TRUST_PROXY_HEADERS=false
# Comma-separated immediate proxy CIDRs. Forwarded headers are ignored unless
# both this list and TRUST_PROXY_HEADERS explicitly trust the connecting peer.
TRUSTED_PROXY_CIDRS=
# Detailed metrics remain loopback-only in PUBLIC_MODE by default.
METRICS_PUBLIC=false
METRICS_LISTEN_ADDR=127.0.0.1:9090

# Preferred public allowlist. Empty means all safe 1-16 char broker region
# labels are allowed. IATA-like labels are still valid, but the app no longer
# requires airport/IATA codes.
PUBLIC_REGIONS=
# Legacy alias kept for 2.x compatibility. Prefer PUBLIC_REGIONS.
PUBLIC_IATAS=

# Optional config file for manual node/observer coordinate overrides
CONFIG_YAML=/app/data/config.yaml

# Optional fixture support
# Credential-free demo fixture. Clear this when using live MQTT.
FIXTURE_REPLAY_PATH=/app/examples/fixtures/synthetic-live.ndjson
FIXTURE_RECORD_ENABLED=false

MC_CARTOLIVE_APP_DIR=/opt/MC-CartoLive
MC_CARTOLIVE_DEPLOY_CURRENT=/var/lib/mc-cartolive-deploy/current.env
MC_CARTOLIVE_AUDIT_STATE_DIR=/var/lib/mc-cartolive-release-audit
MC_CARTOLIVE_AUDIT_RESULT_DIR=/var/log/mc-cartolive-release-audit
MC_CARTOLIVE_AUDIT_READY_URL=http://127.0.0.1:39476/readyz
MC_CARTOLIVE_AUDIT_PUBLIC_STATE_URL=http://127.0.0.1:39476/api/v1/public/state
MC_CARTOLIVE_AUDIT_METRICS_URL=http://127.0.0.1:39090/metrics
MC_CARTOLIVE_DATABASE=/opt/MC-CartoLive/data/meshcore-live.db
MC_CARTOLIVE_AUDIT_SNAPSHOT_DIR=/mnt/mc-cartolive-audit-snapshots
MC_CARTOLIVE_WATCHDOG_STATE=/var/lib/mc-cartolive-watchdog/state.env
MC_CARTOLIVE_CONTAINER=meshcore-canada-live-map
MC_CARTOLIVE_AUDIT_SQL_TIMEOUT_SECONDS=300
MC_CARTOLIVE_AUDIT_SCHEMA_VERSION=32000
MC_CARTOLIVE_AUDIT_MIN_GATE_FREE_GIB=9
MC_CARTOLIVE_AUDIT_MIN_FREE_PERCENT=20

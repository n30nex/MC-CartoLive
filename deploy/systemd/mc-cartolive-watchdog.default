MC_CARTOLIVE_APP_DIR=/opt/MC-CartoLive
MC_CARTOLIVE_SERVICE=meshcore-live-map
MC_CARTOLIVE_READY_URL=http://127.0.0.1:39476/readyz
MC_CARTOLIVE_STATE_DIR=/var/lib/mc-cartolive-watchdog
MC_CARTOLIVE_LOG_FILE=/var/log/mc-cartolive-watchdog.log
MC_CARTOLIVE_MAX_FAILURES=3
MC_CARTOLIVE_MIN_RESTART_SECONDS=600
MC_CARTOLIVE_MAX_CACHE_AGE_MS=120000

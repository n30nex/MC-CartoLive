MC_CARTOLIVE_CONTAINER=meshcore-canada-live-map
MC_CARTOLIVE_READY_URL=http://127.0.0.1:39476/readyz
MC_CARTOLIVE_STATE_DIR=/var/lib/mc-cartolive-watchdog
MC_CARTOLIVE_LOG_FILE=/var/log/mc-cartolive-watchdog.log
MC_CARTOLIVE_MAX_FAILURES=3
MC_CARTOLIVE_MAX_RESTARTS=2
MC_CARTOLIVE_RESTART_WINDOW_SECONDS=21600
MC_CARTOLIVE_BASE_COOLDOWN_SECONDS=600
MC_CARTOLIVE_DATA_DIR=/opt/MC-CartoLive/data
MC_CARTOLIVE_MIN_FREE_PERCENT=20
MC_CARTOLIVE_LOG_LOOKBACK_SECONDS=900
MC_CARTOLIVE_LOG_TAIL_LINES=200
